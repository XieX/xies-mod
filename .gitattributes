# Normalize all text files to LF in the repo and working tree.
* text=auto eol=lf

# Windows batch scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never normalize or diff as text.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.ogg binary
*.nbt binary
*.zip binary
